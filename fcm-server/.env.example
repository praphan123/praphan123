# Firebase Project ID (must match app/google-services.json)
FIREBASE_PROJECT_ID=gen-lang-client-0386658613

# Path to Firebase Admin SDK service account JSON downloaded from Firebase Console
# Project Settings -> Service accounts -> Generate new private key
# Not required on Cloud Run / Cloud Functions when using Application Default Credentials
GOOGLE_APPLICATION_CREDENTIALS=./service-account.json

# HTTP Server Port
PORT=8080

# Background polling interval for USGS + NASA EONET feeds (minutes)
POLL_INTERVAL_MINUTES=5

# Optional shared API secret (if set, clients must send x-api-key header)
SERVER_API_KEY=
